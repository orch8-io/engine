{
  "id": "01933333-0000-7000-8000-000000000004",
  "tenant_id": "demo",
  "namespace": "default",
  "name": "clerk-user-created",
  "version": 1,
  "created_at": "2026-09-01T00:00:00Z",
  "blocks": [
    {
      "type": "router",
      "id": "only_user_created",
      "routes": [
        {
          "condition": "context.data.type == \"user.created\"",
          "blocks": [
            {
              "type": "step",
              "id": "welcome_email",
              "handler": "email",
              "params": {
                "provider": "smtp",
                "smtp": "credentials://smtp",
                "from": "Acme <hello@acme.example>",
                "to": "{{context.data.data.email_addresses.0.email_address}}",
                "subject": "Welcome to Acme",
                "text": "Hi {{context.data.data.first_name}}, welcome aboard!"
              }
            }
          ]
        }
      ],
      "default": [
        {
          "type": "step",
          "id": "ignore",
          "handler": "noop",
          "params": {}
        }
      ]
    }
  ]
}
