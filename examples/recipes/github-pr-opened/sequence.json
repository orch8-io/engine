{
  "id": "01933333-0000-7000-8000-000000000002",
  "tenant_id": "demo",
  "namespace": "default",
  "name": "github-pr-opened",
  "version": 1,
  "created_at": "2026-09-01T00:00:00Z",
  "blocks": [
    {
      "type": "router",
      "id": "only_opened_prs",
      "routes": [
        {
          "condition": "context.data.action == \"opened\" && context.data.pull_request != null",
          "blocks": [
            {
              "type": "step",
              "id": "announce_pr",
              "handler": "notify",
              "params": {
                "provider": "discord",
                "url": "credentials://eng-discord/url",
                "title": "PR #{{context.data.pull_request.number}}: {{context.data.pull_request.title}}",
                "text": "{{context.data.sender.login}} opened a pull request in {{context.data.repository.full_name}}",
                "link": {
                  "url": "{{context.data.pull_request.html_url}}",
                  "label": "Review"
                }
              }
            }
          ]
        }
      ],
      "default": [
        {
          "type": "step",
          "id": "ignore",
          "handler": "noop",
          "params": {}
        }
      ]
    }
  ]
}
