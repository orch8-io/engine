# ── Orch8 engine ────────────────────────────────────────────────────────────
# Leave ORCH8_URL empty (or set it to "mock") to run against the built-in mock
# engine: every page works with fake data and no Orch8 install.
#
# Server-side origin of your engine (no /api/v1 suffix).
ORCH8_URL=http://127.0.0.1:8080

# Tenant API key. SERVER ONLY: it mints embed tokens and must never reach the
# browser. Do not prefix it with NEXT_PUBLIC_.
ORCH8_API_KEY=

# Tenant the API key belongs to.
ORCH8_TENANT_ID=demo

# Origin the *browser* uses to reach the engine, if different from ORCH8_URL
# (e.g. a public hostname). The engine must list this app's origin in
# ORCH8_EMBED_ALLOWED_ORIGINS for CORS.
# ORCH8_PUBLIC_URL=https://orch8.example.com

# Optional: comma-separated sequences an embed token may start/see.
# Empty = every sequence the sub-tenant can access.
# ORCH8_EMBED_SEQUENCES=customer-onboarding

# Workflow started by the "Start" button on /runs and edited on /builder.
ORCH8_DEMO_SEQUENCE=customer-onboarding

# Vendor slug for the "Powered by Orch8" link (?ref=embed&v=<vendor>).
ORCH8_VENDOR=acme-saas
