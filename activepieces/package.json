{
  "name": "@orch8/activepieces-worker",
  "version": "0.1.0",
  "description": "HTTP sidecar that executes ActivePieces community pieces for the Orch8 engine via the ap:// handler prefix",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "orch8-activepieces-worker": "dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "keywords": [
    "orch8",
    "activepieces",
    "workflow",
    "integration",
    "automation"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@activepieces/piece-http": "^0.13.0",
    "@activepieces/piece-slack": "^0.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
