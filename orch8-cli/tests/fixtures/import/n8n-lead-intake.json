        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"properties\": {\n    \"dealname\": \"{{ $json.company }}\",\n    \"pipeline\": \"enterprise\"\n  }\n}",
        "options": { "timeout": 15000 }
