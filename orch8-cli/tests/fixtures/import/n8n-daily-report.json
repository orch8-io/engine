{
  "name": "Daily ops report",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "cronExpression", "expression": "0 7 * * 1-5" }
          ]
        }
      },
      "id": "11111111-aaaa-4bbb-8ccc-000000000001",
      "name": "Weekday 7am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "url": "https://status.example.com/api/v2/summary.json",
        "options": {}
      },
      "id": "11111111-aaaa-4bbb-8ccc-000000000002",
      "name": "Fetch Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $json.status.indicator }}",
                    "rightValue": "none",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "healthy"
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $json.status.indicator }}",
                    "rightValue": "critical",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "critical"
            }
          ]
        },
        "options": { "fallbackOutput": "extra" }
      },
      "id": "11111111-aaaa-4bbb-8ccc-000000000003",
      "name": "Route by Status",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [440, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "name": "summary", "value": "All systems operational", "type": "string" }
          ]
        }
      },
      "id": "11111111-aaaa-4bbb-8ccc-000000000004",
      "name": "Healthy Summary",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [660, -120]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://events.pagerduty.com/v2/enqueue",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "routing_key", "value": "R0UT1NGKEY" },
            { "name": "event_action", "value": "trigger" },
            { "name": "summary", "value": "={{ $json.status.description }}" }
          ]
        },
        "options": {}
      },
      "id": "11111111-aaaa-4bbb-8ccc-000000000005",
      "name": "Page On-call",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "name": "summary", "value": "=Degraded: {{ $json.status.description }}", "type": "string" }
          ]
        }
      },
      "id": "11111111-aaaa-4bbb-8ccc-000000000006",
      "name": "Degraded Summary",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [660, 120]
    },
    {
      "parameters": {
        "functionCode": "return items.map(i => ({ json: { line: `${new Date().toISOString()} ${i.json.summary}` } }));"
      },
      "id": "11111111-aaaa-4bbb-8ccc-000000000007",
      "name": "Format Line (legacy)",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [880, 0]
    }
  ],
  "connections": {
    "Weekday 7am": { "main": [[{ "node": "Fetch Status", "type": "main", "index": 0 }]] },
    "Fetch Status": { "main": [[{ "node": "Route by Status", "type": "main", "index": 0 }]] },
    "Route by Status": {
      "main": [
        [{ "node": "Healthy Summary", "type": "main", "index": 0 }],
        [{ "node": "Page On-call", "type": "main", "index": 0 }],
        [{ "node": "Degraded Summary", "type": "main", "index": 0 }]
      ]
    },
    "Healthy Summary": { "main": [[{ "node": "Format Line (legacy)", "type": "main", "index": 0 }]] },
    "Degraded Summary": { "main": [[{ "node": "Format Line (legacy)", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1", "timezone": "Europe/Berlin" },
  "id": "aB3dE5fG7hJ9kL1m"
}
